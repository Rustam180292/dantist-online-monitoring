# PostgreSQL ulanish manzili.
# Bepul baza: neon.tech yoki supabase.com da loyiha ochib, manzilni shu yerga qo'ying.
DATABASE_URL="postgresql://foydalanuvchi:parol@host/logoped?sslmode=require"

# Sessiya cookie imzosi uchun kalit. Prodda albatta o'zgartiring:
#   openssl rand -hex 32
SESSION_SECRET="almashtiring-bu-kalitni-productionda"

# --- Telegram Mini App ---
# @BotFather dan olinadi. Bo'sh bo'lsa Telegram qismi o'chiq turadi.
TELEGRAM_BOT_TOKEN=""
# setWebhook da beriladigan maxfiy so'z (begona so'rovlarni to'sadi)
TELEGRAM_WEBHOOK_SECRET=""
# Mini App ochiladigan manzil (HTTPS bo'lishi shart, lokalda http mumkin)
APP_URL="http://localhost:3000"
# Eslatmalarni yuboradigan cron uchun maxfiy so'z
CRON_SECRET=""

# Login sahifasida demo hisoblar ro'yxatini ko'rsatish (faqat sinov uchun).
# Haqiqiy markaz ishlayotgan saytda BO'SH qoldiring — aks holda istalgan odam
# markaz egasi sifatida kira oladi.
DEMO_LOGINS=""

# --- Android ilovasi (APK) ---
# APK pwabuilder.com da yasaladi (DEPLOY.md, "Android ilovasi" bo'limi).
# Ikkalasi to'ldirilsa, ilova tepasida brauzer satri ko'rinmaydi.
ANDROID_PACKAGE_NAME=""
# Imzo kalitining SHA-256 izi (AA:BB:...). Bir nechta bo'lsa vergul bilan.
ANDROID_SHA256_FINGERPRINTS=""
